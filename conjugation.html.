    const choices=[correct];
    while(choices.length<4 && pool.length) {
      const candidate=pool[Math.floor(Math.random()*pool.length)];
      if(!choices.includes(candidate)) choices.push(candidate);
    }
    if(choices.length<4) throw Error();
    choices.sort(()=>Math.random()-.5);
    quizAnswer=correct;
    document.getElementById("question").textContent=
      "Choose the correct present form: "+pronoun+" ("+selected[0]+")";
    const area=document.getElementById("choices");
    choices.forEach(c=>{
      const b=document.createElement("button");
      b.textContent=c;
      b.style.margin="5px";
      b.onclick=()=>checkAnswer(c);
      area.appendChild(b);
    });
  })
  .catch(()=>{
    document.getElementById("question").textContent=
      "Quiz data could not be loaded. Please try again.";
  });
}

function checkAnswer(choice) {
  const area=document.getElementById("choices");
  if(choice===quizAnswer) {
    score++;
    document.getElementById("score").textContent=
      "Correct! Your score: "+score;
  } else {
    document.getElementById("score").textContent=
      "Not quite. Correct answer: "+quizAnswer+". Score: "+score;
  }
  area.innerHTML="";
}
</script>
</body>
