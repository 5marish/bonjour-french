function findVerb() {
  const q=document.getElementById("search").value.trim().toLowerCase();
  const found=verbs.find(v=>v[0].toLowerCase()===q);
  if(!found) {
    document.getElementById("status").textContent="Verb not found in the list. Try its French infinitive.";
    return;
  }
  document.getElementById("verbSelect").value=found[0];
  loadConjugation();
}

function normalize(s) {
  return String(s||"").normalize("NFD")
    .replace(/[\u0300-\u036f]/g,"").toLowerCase()
    .replace(/[^a-z0-9]/g,"");
}

function findTense(data, target) {
  const wanted=normalize(target);
  let found=null;
  function walk(obj,path=[]) {
    if(found || !obj || typeof obj!=="object") return;
    if(Array.isArray(obj)) {
      if(obj.length && obj.every(x=>x && typeof x==="object" &&
        ("pronom" in x || "texte" in x || "valeur" in x))) {
        found=obj;
        return;
      }
      obj.forEach((x,i)=>walk(x,path.concat(String(i))));
      return;
    }
    for(const [k,v] of Object.entries(obj)) {
      if(normalize(k)===wanted) {
        const before=found;
        walk(v,path.concat(k));
        if(found) return;
      }
    }
    for(const v of Object.values(obj)) walk(v,path);
  }
  walk(data);
  return found;
}

async function loadConjugation() {
  const verb=document.getElementById("verbSelect").value;
  if(!verb) {
    document.getElementById("status").textContent="Please choose a verb.";
    return;
  }
  document.getElementById("status").textContent="Loading conjugation...";
  document.getElementById("result").innerHTML="";
  try {
    const response=await fetch("https://conjugaison.app/"+slug(verb)+".json");
    if(!response.ok) throw new Error("Data unavailable");
    currentData=await response.json();
    displayTense();
    document.getElementById("status").textContent="Conjugation data loaded.";
  } catch(e) {
    document.getElementById("status").textContent=
      "Could not load this verb. Please check your internet connection or try again later.";
  }
}

function displayTense() {
  if(!currentData) return;
  const key=document.getElementById("tenseSelect").value;
  const info=tenses[key];
  const forms=findTense(currentData,info[1]) ||
               findTense(currentData,info[2]);
  if(!forms) {
    document.getElementById("result").innerHTML=
      "<p>This tense was not found in the data for this verb.</p>";
    return;
  }
  const rows=forms.map(f=>{
    const person=f.pronom||"";
    const form=f.texte||((person+" "+(f.valeur||"")).trim());
    return "<tr><td>"+escapeHTML(person)+"</td><td class='answer'>"+
      escapeHTML(form)+"</td></tr>";
  }).join("");
  document.getElementById("result").innerHTML=
    "<h3>"+escapeHTML(document.getElementById("verbSelect").value)+
    " — "+escapeHTML(info[1])+"</h3><table><tr><th>Subject</th>"+
    "<th>Conjugation</th></tr>"+rows+"</table>";
}

document.getElementById("tenseSelect").addEventListener("change",displayTense);
document.getElementById("verbSelect").addEventListener("change",loadConjugation);

function escapeHTML(s) {
  return String(s).replace(/[&<>"']/g,c=>({
    "&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"
  }[c]));
}

function collectForms(obj,out=[]) {
  if(!obj || typeof obj!=="object") return out;
  if(Array.isArray(obj)) {
    obj.forEach(x=>collectForms(x,out));
  } else if("texte" in obj || "valeur" in obj) {
    const v=obj.texte||obj.valeur;
    if(v) out.push(v);
  } else {
    Object.values(obj).forEach(x=>collectForms(x,out));
  }
  return out;
}

